---
import data from '../data.json';
import Layout from '../layouts/Layout.astro';

// Extract unique jobs and countries for the dropdowns
const uniqueJobs = [...new Set(data.map(item => item.jobTitle))].sort();
const uniqueCountries = [...new Set(data.map(item => item.countryName))].sort();
---

<Layout title="Compare Markets | EverywhereJob" description="Evaluate local compensation, living costs, and visa friction between two target markets simultaneously.">
  <style>
    .intro-section { text-align: center; margin-bottom: 3rem; margin-top: 2rem; }
    .intro-section h1 { font-size: 2.25rem; color: #ffffff; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 0.75rem; text-transform: uppercase; }
    .intro-section p { font-size: 1.05rem; color: #a1a1aa; max-width: 600px; margin: 0 auto; }
    
    .controls-card { background: #18181b; border: 1px solid #27272a; border-radius: 6px; padding: 1.5rem; margin-bottom: 2rem; display: flex; flex-direction: column; gap: 1.5rem; }
    .control-group { display: flex; flex-direction: column; gap: 0.5rem; }
    .control-group label { font-size: 0.85rem; font-weight: 700; color: #a1a1aa; text-transform: uppercase; letter-spacing: 0.05em; }
    select { width: 100%; padding: 0.85rem; background: #09090b; color: #ffffff; border: 1px solid #27272a; border-radius: 4px; font-size: 1rem; outline: none; appearance: none; cursor: pointer; }
    select:focus { border-color: #10b981; }
    
    .comparison-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .data-column { background: #18181b; border: 1px solid #27272a; border-radius: 6px; padding: 1.5rem; min-height: 400px; }
    .col-title { font-size: 1.25rem; color: #ffffff; font-weight: 700; margin-top: 0; margin-bottom: 1.5rem; border-bottom: 1px solid #27272a; padding-bottom: 0.75rem; }
    
    :global(.data-row) { display: flex; justify-content: space-between; padding: 1rem 0; border-bottom: 1px solid #27272a; align-items: center; }
    :global(.data-row:last-child) { border-bottom: none; }
    :global(.data-label) { color: #a1a1aa; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
    :global(.data-value) { font-weight: 700; color: #ffffff; font-size: 1rem; text-align: right; max-width: 60%; line-height: 1.3; }
    :global(.win-highlight) { color: #10b981; }

    .empty-state { text-align: center; padding: 3rem 1rem; color: #71717a; font-style: italic; }

    @media (max-width: 768px) { .comparison-grid { grid-template-columns: 1fr; } }
  </style>

  <div class="wrapper">
    <section class="intro-section">
      <h1>Market Comparison Engine</h1>
      <p>Evaluate local compensation, living costs, and visa friction between two target markets simultaneously.</p>
    </section>

    <div class="controls-card">
      <div class="control-group">
        <label for="jobSelector">Target Profession</label>
        <select id="jobSelector">
          <option value="" disabled selected>Select a profession to establish baseline...</option>
          {uniqueJobs.map(job => <option value={job}>{job}</option>)}
        </select>
      </div>
      
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
        <div class="control-group">
          <label for="countryA">Node Alpha</label>
          <select id="countryA" disabled>
            <option value="" disabled selected>Select first market...</option>
            {uniqueCountries.map(c => <option value={c}>{c}</option>)}
          </select>
        </div>
        <div class="control-group">
          <label for="countryB">Node Beta</label>
          <select id="countryB" disabled>
            <option value="" disabled selected>Select second market...</option>
            {uniqueCountries.map(c => <option value={c}>{c}</option>)}
          </select>
        </div>
      </div>
    </div>

    <div class="comparison-grid">
      <div class="data-column" id="colA">
        <h2 class="col-title">Node Alpha Data</h2>
        <div class="empty-state">Awaiting parameter selection...</div>
      </div>
      <div class="data-column" id="colB">
        <h2 class="col-title">Node Beta Data</h2>
        <div class="empty-state">Awaiting parameter selection...</div>
      </div>
    </div>
  </div>

  <script define:vars={{ db: data }}>
    document.addEventListener('DOMContentLoaded', () => {
      const jobSel = document.getElementById('jobSelector');
      const countA = document.getElementById('countryA');
      const countB = document.getElementById('countryB');
      const colA = document.getElementById('colA');
      const colB = document.getElementById('colB');

      jobSel.addEventListener('change', () => {
        countA.disabled = false;
        countB.disabled = false;
        renderComparison();
      });

      countA.addEventListener('change', renderComparison);
      countB.addEventListener('change', renderComparison);

      function renderComparison() {
        const job = jobSel.value;
        const valA = countA.value;
        const valB = countB.value;

        if (!job) return;

        const dataA = db.find(d => d.jobTitle === job && d.countryName === valA);
        const dataB = db.find(d => d.jobTitle === job && d.countryName === valB);

        updateColumn(colA, dataA, valA, dataB);
        updateColumn(colB, dataB, valB, dataA);
      }

      function updateColumn(element, targetData, targetName, opponentData) {
        if (!targetName) {
          element.innerHTML = `<h2 class="col-title">Pending</h2><div class="empty-state">Select a market node...</div>`;
          return;
        }
        if (!targetData) {
          element.innerHTML = `<h2 class="col-title">${targetName}</h2><div class="empty-state">No verified data for this profession in ${targetName}.</div>`;
          return;
        }

        const isSalaryWinner = opponentData && targetData.localSalary > opponentData.localSalary;
        const isCostWinner = opponentData && targetData.costOfLiving < opponentData.costOfLiving;

        element.innerHTML = `
          <h2 class="col-title">${targetData.countryName}</h2>
          <div class="data-row"><span class="data-label">Local Compensation</span><span class="data-value ${isSalaryWinner ? 'win-highlight' : ''}">$${targetData.localSalary.toLocaleString()} / mo</span></div>
          <div class="data-row"><span class="data-label">Living Index</span><span class="data-value ${isCostWinner ? 'win-highlight' : ''}">$${targetData.costOfLiving.toLocaleString()} / mo</span></div>
          <div class="data-row"><span class="data-label">Net Surplus</span><span class="data-value">$${(targetData.localSalary - targetData.costOfLiving).toLocaleString()} / mo</span></div>
          <div class="data-row" style="margin-top: 1rem;"><span class="data-label">Visa Protocol</span><span class="data-value" style="font-size: 0.85rem;">${targetData.localVisa}</span></div>
          <a href="/countries/${targetData.countrySlug}/${targetData.jobSlug}/local" style="display:block; margin-top:2rem; text-align:center; background:#27272a; color:#ffffff; padding:0.75rem; border-radius:4px; text-decoration:none; font-size:0.85rem; font-weight:600;">View Full Matrix ↗</a>
        `;
      }
    });
  </script>
</Layout>