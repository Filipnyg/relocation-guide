---
import data from '../../data.json';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const uniqueJobs = [...new Set(data.map(item => item.jobTitle))];
  return uniqueJobs.map(title => {
    const slug = data.find(item => item.jobTitle === title).jobSlug;
    return {
      params: { job: slug },
      props: { jobTitle: title }
    };
  });
}

const { job } = Astro.params;
const { jobTitle } = Astro.props;

const availableCountries = data
  .filter(item => item.jobSlug === job)
  .sort((a, b) => a.countryName.localeCompare(b.countryName));
---

<Layout title={`Global Salaries for ${jobTitle}s - EverywhereJob`} description={`Compare average salaries and visa options for ${jobTitle}s across different countries.`}>
  <style>
    .breadcrumb { font-size: 0.8rem; color: #71717a; margin-bottom: 2rem; }
    .breadcrumb a { color: #10b981; text-decoration: none; }
    .breadcrumb a:hover { text-decoration: underline; }
    .breadcrumb span { margin: 0 0.3rem; color: #3f3f46; }

    .card { background: #18181b; border-radius: 6px; padding: 2.5rem; border: 1px solid #27272a; }
    h1 { font-size: 1.75rem; margin-top: 0; color: #ffffff; font-weight: 800; letter-spacing: -0.02em; }
    .subtitle { color: #a1a1aa; font-size: 0.95rem; margin-bottom: 2.5rem; line-height: 1.5; }
    
    .link-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
    .link-list li { display: flex; justify-content: space-between; align-items: center; padding: 1rem; background: #09090b; border: 1px solid #27272a; border-radius: 4px; }
    .link-list li:hover { border-color: #10b981; }
    .country-link { font-weight: 600; text-decoration: none; color: #ffffff; font-size: 1rem; }
    .search-inline-link { font-size: 0.8rem; color: #a1a1aa; text-decoration: none; margin-top: 0.25rem; display: block; }
    .search-inline-link:hover { color: #10b981; text-decoration: underline; }
    .badge { background: #27272a; color: #10b981; padding: 0.4rem 0.75rem; border-radius: 4px; font-size: 0.8rem; text-decoration: none; font-weight: 700; border: 1px solid #27272a; }
    
    @media (max-width: 600px) { .link-list li { flex-direction: column; align-items: flex-start; gap: 1rem; } }
  </style>

  <div class="wrapper">
    <div class="card">
      <nav class="breadcrumb">
        <a href="/">Home</a> <span>/</span> {jobTitle}
      </nav>

      <h1>Global {jobTitle} Salaries</h1>
      <p class="subtitle">Compare average salaries and visa options for {jobTitle}s across different countries.</p>
      <ul class="link-list">
        {availableCountries.map(c => {
          const defaultLink = c.canWorkRemote !== false ? 'remote' : 'local';
          return (
            <li>
              <div>
                <a href={`/countries/${c.countrySlug}/${job}/${defaultLink}`} class="country-link">{c.countryName}</a>
                <a href={`https://www.google.com/search?q=${jobTitle}+jobs+in+${c.countryName}`} target="_blank" rel="noopener noreferrer" class="search-inline-link">Search Local Jobs ↗</a>
              </div>
              <a href={`/countries/${c.countrySlug}/${job}/${defaultLink}`} class="badge">${c.localSalary.toLocaleString()} / mo</a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</Layout>