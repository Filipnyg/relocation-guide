---
import data from '../../data.json';

export async function getStaticPaths() {
  const uniqueJobs = [...new Set(data.map(item => item.jobTitle))];
  return uniqueJobs.map(title => {
    const slug = data.find(item => item.jobTitle === title).jobSlug;
    return {
      params: { job: slug },
      props: { jobTitle: title }
    };
  });
}

const { job } = Astro.params;
const { jobTitle } = Astro.props;

const availableCountries = data
  .filter(item => item.jobSlug === job)
  .sort((a, b) => a.countryName.localeCompare(b.countryName));
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Best Countries for {jobTitle}s - EverywhereJob</title>
    <style>
      body { font-family: 'Inter', sans-serif; background-color: #f4f4f5; color: #3f3f46; margin: 0; padding-bottom: 4rem; }
      .site-header { background: #ffffff; border-bottom: 1px solid #e4e4e7; padding: 1.25rem 1.5rem; margin-bottom: 3rem; }
      .header-container { max-width: 760px; margin: 0 auto; display: flex; text-decoration: none; color: #18181b; font-weight: 800; font-size: 1.2rem; }
      .logo-highlight { color: #16a34a; }
      .wrapper { max-width: 760px; margin: 0 auto; padding: 0 1.5rem; }
      .card { background: #ffffff; border-radius: 20px; padding: 3rem; border: 1px solid #e4e4e7; }
      h1 { font-size: 2.2rem; margin-top: 0; color: #18181b; }
      .subtitle { color: #71717a; font-size: 1.1rem; margin-bottom: 2.5rem; }
      .link-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.75rem; }
      .link-list li { display: flex; justify-content: space-between; align-items: center; padding: 1rem; background: #fafafa; border: 1px solid #f4f4f5; border-radius: 10px; }
      .country-link { font-weight: 600; text-decoration: none; color: #27272a; font-size: 1.1rem; }
      .country-link:hover { color: #16a34a; }
      .search-inline-link { font-size: 0.85rem; color: #16a34a; text-decoration: underline; margin-top: 0.2rem; display: block; }
      .badge { background: #e4e4e7; color: #52525b; padding: 0.2rem 0.6rem; border-radius: 6px; font-size: 0.85rem; text-decoration: none; font-weight: 700; }
      .link-list li:hover .badge { background: #dcfce7; color: #15803d; }
    </style>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="header-container">💼 Everywhere<span class="logo-highlight">Job</span></a>
    </header>
    <div class="wrapper">
      <div class="card">
        <h1>Global Markets for {jobTitle}s</h1>
        <p class="subtitle">Select a destination below to unlock verified local salaries, income tax brackets, and official relocation visas for a {jobTitle}.</p>
        <ul class="link-list">
          {availableCountries.map(c => (
            <li>
              <div>
                <a href={`/countries/${c.countrySlug}/${job}/remote`} class="country-link">{c.countryName}</a>
                <a href={`https://www.google.com/search?q=${jobTitle}+jobs+in+${c.countryName}`} target="_blank" rel="noopener noreferrer" class="search-inline-link">Browse local openings on Google →</a>
              </div>
              <a href={`/countries/${c.countrySlug}/${job}/remote`} class="badge">${c.localSalary.toLocaleString()} / mo →</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </body>
</html>