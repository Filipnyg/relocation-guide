---
import Layout from '../layouts/Layout.astro';
---

<Layout title="System Resources | EverywhereJob">
  <style>
    .card { background: #18181b; border-radius: 6px; padding: 2.5rem; border: 1px solid #27272a; }
    h1 { font-size: 2rem; color: #ffffff; margin-top: 0; margin-bottom: 1.5rem; font-weight: 800; letter-spacing: -0.02em; text-transform: uppercase; }
    .resource-item { padding: 1.5rem; border: 1px solid #27272a; border-radius: 4px; background: #09090b; margin-bottom: 1rem; }
    .resource-item h3 { margin-top: 0; color: #10b981; font-size: 1.1rem; }
    .resource-item p { color: #a1a1aa; font-size: 0.9rem; margin-bottom: 0; }
  </style>

  <div class="wrapper">
    <div class="card">
      <h1>Data Sources & Resources</h1>
      
      <div class="resource-item">
        <h3>Numbeo API</h3>
        <p>Our primary source for calculating average living costs across different cities and countries.</p>
      </div>
      
      <div class="resource-item">
        <h3>Official Immigration Portals</h3>
        <p>We link directly to official government websites so you can find accurate, up-to-date visa application requirements.</p>
      </div>
    </div>
  </div>
</Layout>