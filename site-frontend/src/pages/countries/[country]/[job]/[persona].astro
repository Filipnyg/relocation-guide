---
import data from '../../../../data.json';

export async function getStaticPaths() {
  const paths = [];
  data.forEach((row) => {
    paths.push({
      params: { country: row.countrySlug, job: row.jobSlug, persona: 'remote' },
      props: { data: row, type: 'remote' },
    });
    paths.push({
      params: { country: row.countrySlug, job: row.jobSlug, persona: 'local' },
      props: { data: row, type: 'local' },
    });
  });
  return paths;
}

const { data, type } = Astro.props;

// A diverse collection of 20 high-quality Unsplash scenery/cityscape IDs
const photoIds = [
  "photo-1506744038136-46273834b3fb", "photo-1517736996458-ee3bc867a145",
  "photo-1513622470522-26c3c8a854bc", "photo-1527004013197-933c4bb611b3",
  "photo-1528154291023-a6525fabb169", "photo-1523482596083-d46196c3365f",
  "photo-1543783207-ec64e4d95325", "photo-1467269204594-9661b134dd2b",
  "photo-1513635269975-59663e0ca1ad", "photo-1501594907352-04cda38ebc29",
  "photo-1507608869274-d3177c8bb4c7", "photo-1493976040374-85c8e12f0c0e",
  "photo-1525625293386-3f8f99389edd", "photo-1502602898657-3e91760cbb34",
  "photo-1498050108023-c5249f4df085", "photo-1508009603885-50cf7c579365",
  "photo-1476514525535-07fb3b4ae5f1", "photo-1504150558240-0b4fd8946624",
  "photo-1512453979798-5ea266f8880c", "photo-1480796927426-f609979314bd"
];

// Creates a unique but consistent number from the country's name to assign a varied photo
const charSum = data.countryName.split('').reduce((sum, char) => sum + char.charCodeAt(0), 0);
const selectedPhoto = photoIds[charSum % photoIds.length];

// Market Entry Friction Engine
const getDifficultyRating = (salary, country) => {
  if (salary > 8000 || ["switzerland", "united-states", "singapore"].includes(country)) {
    return { level: "High", color: "#ef4444", text: "Competitive market entry. Requires stringent visa sponsorship tracking or established high-tier foreign employment criteria." };
  } else if (salary > 4500) {
    return { level: "Moderate", color: "#f59e0b", text: "Standard professional criteria. Readily achievable for mid-to-senior profiles with verified enterprise backgrounds." };
  }
  return { level: "Accessible", color: "#10b981", text: "Highly welcoming pipeline. Streamlined processing or low barrier financial benchmarks for incoming engineering professionals." };
};

const marketFriction = getDifficultyRating(data.localSalary, data.countrySlug);
const estRemoteSalary = data.localSalary > 4000 ? data.localSalary + 1500 : 5500 + (data.jobTitle.length * 100);
const localTaxDisplay = data.countryName === 'United Arab Emirates' ? '0% Personal Income Tax' : 'Standard progressive local tax scales';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="EK2aLb4_ZKCvOfSWETXcFD-0_YOvd2vb-Zr16AsYQb4" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Moving to {data.countryName} as a {data.jobTitle} | EverywhereJob</title>
    <meta name="description" content={`A complete relocation guide for a ${data.jobTitle} moving to ${data.countryName}. Compare visa options, salaries, and tax rates.`} />
    
    <style>
      body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background-color: #f4f4f5; color: #3f3f46; line-height: 1.6; padding: 0 0 4rem 0; margin: 0; }
      .site-header { background: #ffffff; border-bottom: 1px solid #e4e4e7; padding: 1.25rem 1.5rem; position: sticky; top: 0; z-index: 100; margin-bottom: 3rem; }
      .header-container { max-width: 760px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
      .logo-link { display: flex; align-items: center; gap: 0.5rem; text-decoration: none; transition: opacity 0.2s; }
      .logo-link:hover { opacity: 0.8; }
      .logo-text { font-weight: 800; font-size: 1.2rem; color: #18181b; letter-spacing: -0.03em; }
      .logo-highlight { color: #16a34a; }
      .nav-text-link:hover { color: #18181b !important; }
      .get-started-btn { background: #16a34a; color: white; padding: 0.5rem 1.25rem; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.9rem; transition: background 0.2s; }
      .get-started-btn:hover { background: #15803d; }
      .wrapper { max-width: 760px; margin: 0 auto; padding: 0 1.5rem; }
      .card { background: #ffffff; border-radius: 20px; padding: 3rem; box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.05); border: 1px solid #e4e4e7; }
      .hero-image { width: 100%; height: 280px; object-fit: cover; border-radius: 12px; margin-bottom: 2rem; background-color: #e4e4e7; }
      h1 { font-size: 2.2rem; color: #18181b; margin-top: 0; font-weight: 800; letter-spacing: -0.03em; }
      .toggle-container { display: inline-flex; background: #f4f4f5; padding: 6px; border-radius: 14px; margin: 1.5rem 0 2.5rem 0; }
      .toggle-container a { padding: 0.85rem 1.5rem; text-decoration: none; color: #71717a; font-weight: 600; border-radius: 10px; font-size: 0.95rem; }
      .toggle-container a.active { background: #ffffff; color: #18181b; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }
      .data-grid { display: flex; flex-direction: column; gap: 1rem; margin-top: 1.5rem; }
      .data-row { display: flex; justify-content: space-between; padding: 1.25rem 1.5rem; background: #fafafa; border-radius: 12px; border: 1px solid #f4f4f5; align-items: center; }
      .data-label { color: #71717a; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
      .data-value { font-weight: 700; color: #18181b; font-size: 1.1rem; text-align: right; }
      .difficulty-box { margin-top: 2rem; padding: 1.5rem; border-radius: 12px; border-left: 5px solid var(--accent-color); background: #fafafa; }
      .context-box { margin-top: 3.5rem; padding-top: 2.5rem; border-top: 1px solid #e4e4e7; }
      .context-box h2 { font-size: 1.5rem; color: #18181b; margin-bottom: 1rem; }
      .search-card { margin-top: 1rem; background: #ffffff; padding: 1.5rem; border-radius: 16px; border: 1px solid #e4e4e7; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
      .portal-card { margin-top: 1rem; background: linear-gradient(145deg, #f0fdf4 0%, #dcfce7 100%); padding: 2rem; border-radius: 16px; border: 1px solid #bbf7d0; display: flex; align-items: center; justify-content: space-between; }
      .portal-btn { background: #16a34a; color: white; padding: 0.85rem 1.75rem; border-radius: 10px; text-decoration: none; font-weight: 600; }
      .search-btn { background: #f4f4f5; color: #3f3f46; padding: 0.5rem 1rem; border-radius: 8px; text-decoration: none; font-weight: 600; }
      footer { text-align: center; margin-top: 4rem; font-size: 0.8rem; color: #a1a1aa; }
      @media (max-width: 600px) { .data-row { flex-direction: column; align-items: flex-start; gap: 0.5rem; } .search-card, .portal-card { flex-direction: column; align-items: flex-start; } }
      .contact-pane { background: #18181b; color: #ffffff; padding: 4rem 1.5rem; margin-top: 4rem; text-align: center; }
      .contact-container { max-width: 600px; margin: 0 auto; }
      .contact-container h2 { margin-top: 0; font-size: 2rem; margin-bottom: 0.5rem; color: #ffffff; }
      .contact-container p { color: #a1a1aa; margin-bottom: 2rem; font-size: 1.05rem; }
      .contact-form { display: flex; flex-direction: column; gap: 1rem; }
      .contact-form input, .contact-form textarea { width: 100%; padding: 1rem; border-radius: 8px; border: 1px solid #3f3f46; background: #27272a; color: white; font-family: inherit; font-size: 1rem; box-sizing: border-box; }
      .contact-form button { background: #16a34a; color: white; border: none; padding: 1rem; border-radius: 8px; font-weight: 700; font-size: 1rem; cursor: pointer; transition: background 0.2s; }
      .contact-form button:hover { background: #15803d; }
      /* --- CONTACT FOOTER STYLES --- */
      .contact-pane { background: #18181b; color: #ffffff; padding: 4rem 1.5rem; margin-top: 4rem; text-align: center; }
      .contact-container { max-width: 600px; margin: 0 auto; }
      .contact-container h2 { margin-top: 0; font-size: 2rem; margin-bottom: 0.5rem; color: #ffffff; }
      .contact-container p { color: #a1a1aa; margin-bottom: 2rem; font-size: 1.05rem; }
      .contact-form { display: flex; flex-direction: column; gap: 1rem; text-align: left; }
      .contact-form input, .contact-form textarea { width: 100%; padding: 1rem; border-radius: 8px; border: 1px solid #3f3f46; background: #27272a; color: white; font-family: inherit; font-size: 1rem; box-sizing: border-box; outline: none; transition: border-color 0.2s; }
      .contact-form input:focus, .contact-form textarea:focus { border-color: #16a34a; }
      .contact-form button { background: #16a34a; color: white; border: none; padding: 1rem; border-radius: 8px; font-weight: 700; font-size: 1.1rem; cursor: pointer; transition: background 0.2s; margin-top: 0.5rem; }
      .contact-form button:hover { background: #15803d; }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="header-container" style="justify-content: space-between; width: 100%;">
        <a href="/" class="logo-link" style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none;">
          <span class="logo-icon">💼</span>
          <span class="logo-text">Everywhere<span class="logo-highlight">Job</span></span>
        </a>
        <div style="display: flex; gap: 1.5rem; align-items: center;">
          <a href="/resources" class="nav-text-link" style="color: #71717a; text-decoration: none; font-weight: 600; font-size: 0.95rem; transition: color 0.2s;">Resources</a>
          <a href="/guide" class="get-started-btn">Get Started</a>
        </div>
      </div>
    </header>

    <div class="wrapper">
      <div class="card">
        <img src={`https://images.unsplash.com/${selectedPhoto}?auto=format&fit=crop&w=800&q=80`} alt={data.countryName} class="hero-image" />
        <h1>{data.jobTitle} Salary & Visa Guide in {data.countryName}</h1>
        
        <nav class="toggle-container">
          <a href={`/countries/${data.countrySlug}/${data.jobSlug}/remote`} class={type === 'remote' ? 'active' : ''}>Remote Worker</a>
          <a href={`/countries/${data.countrySlug}/${data.jobSlug}/local`} class={type === 'local' ? 'active' : ''}>Local Hire</a>
        </nav>

        <main>
          {type === 'remote' ? (
            <div class="data-grid">
              <div class="data-row"><span class="data-label">Cost of Living</span><span class="data-value">${data.costOfLiving.toLocaleString()} / mo</span></div>
              <div class="data-row"><span class="data-label">Est. Remote Salary</span><span class="data-value">${estRemoteSalary.toLocaleString()} / mo</span></div>
              <div class="data-row"><span class="data-label">Remote Income Tax</span><span class="data-value">{data.nomadTax}</span></div>
              <div class="data-row"><span class="data-label">Visa Option</span><span class="data-value">{data.nomadVisa}</span></div>
            </div>
          ) : (
            <div class="data-grid">
              <div class="data-row"><span class="data-label">Cost of Living</span><span class="data-value">${data.costOfLiving.toLocaleString()} / mo</span></div>
              <div class="data-row"><span class="data-label">Avg. Local Salary</span><span class="data-value">${data.localSalary.toLocaleString()} / mo</span></div>
              <div class="data-row"><span class="data-label">Local Income Tax</span><span class="data-value">{localTaxDisplay}</span></div>
              <div class="data-row"><span class="data-label">Visa Option</span><span class="data-value">{data.localVisa}</span></div>
            </div>
          )}
        </main>

        <section class="difficulty-box" style={`--accent-color: ${marketFriction.color}`}>
          <h3 style={`margin: 0 0 0.25rem 0; color: ${marketFriction.color}`}>Job Market Difficulty: {marketFriction.level}</h3>
          <p style="margin: 0; color: #52525b; font-size: 0.95rem;">{marketFriction.text}</p>
        </section>

        <section class="search-card">
          <div><h3>Find Open Roles</h3><p>Active {data.jobTitle} openings in {data.countryName}.</p></div>
          <div style="display:flex; gap:0.5rem;">
            <a href={`https://www.linkedin.com/jobs/search/?keywords=${data.jobTitle}&location=${data.countryName}`} target="_blank" class="search-btn">LinkedIn</a>
            <a href={`https://www.google.com/search?q=${data.jobTitle}+jobs+in+${data.countryName}`} target="_blank" class="search-btn">Google</a>
          </div>
        </section>

        <section class="portal-card">
          <div><h3>Official Portal</h3><p>Use government resources to apply.</p></div>
          <a href={data.visaLink} target="_blank" class="portal-btn">Visit Immigration →</a>
        </section>

        <section class="context-box">
          <h2>Living in {data.countryName} as a {data.jobTitle}</h2>
          <p>{data.localContext}</p>
          <p style="margin-top: 1rem; color: #52525b;">Relocating to {data.countryName} offers distinct adjustments depending on lifestyle choices. Beyond housing expenses, professionals must plan around localized public infrastructure accessibility, progressive tax bracket limits, and regional healthcare registration requirements necessary to maintain baseline stability.</p>
        </section>

        </div> </div> <footer class="contact-pane">
      <div class="contact-container">
        <h2>Get in Touch</h2>
        <p>Have questions about a specific market or want to report outdated data? Drop us a line.</p>
        
        <form action="https://formspree.io/f/xgobqeky" method="POST" class="contact-form">
          <input type="email" name="email" placeholder="Your Email Address" required />
          <textarea name="message" rows="4" placeholder="How can we help?" required></textarea>
          <button type="submit">Send Message</button>
        </form>
        
        <p style="margin-top: 3rem; font-size: 0.8rem; color: #52525b;">
          EverywhereJob — Data sourced via Numbeo indexing databases, local statutory immigration logs, and ongoing international compensation reviews.
        </p>
      </div>
    </footer>
  </body>
</html>