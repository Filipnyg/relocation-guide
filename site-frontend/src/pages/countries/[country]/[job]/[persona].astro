---
import data from '../../../../data.json';

export async function getStaticPaths() {
  const paths = [];
  data.forEach((row) => {
    paths.push({
      params: { country: row.countrySlug, job: row.jobSlug, persona: 'nomad' },
      props: { data: row, type: 'nomad' },
    });
    paths.push({
      params: { country: row.countrySlug, job: row.jobSlug, persona: 'expat' },
      props: { data: row, type: 'expat' },
    });
  });
  return paths;
}

const { data, type } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="EK2aLb4_ZKCvOfSWETXcFD-0_YOvd2vb-Zr16AsYQb4" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Moving to {data.countryName} as a {data.jobTitle} ({type === 'nomad' ? 'Remote Guide' : 'Local Guide'})</title>
    <meta name="description" content={`A complete 2026 relocation guide for a ${data.jobTitle} moving to ${data.countryName}. Compare visa options, salaries, and tax rates.`} />
    
    <style>
      /* Modern Reset & Typography */
      body { 
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
        background-color: #f4f4f5; 
        color: #3f3f46; 
        line-height: 1.6; 
        padding: 0 0 4rem 0; /* Adjusted for top header layout */
        margin: 0;
      }

      /* Premium Header Bar */
      .site-header {
        background: #ffffff;
        border-bottom: 1px solid #e4e4e7;
        padding: 1.25rem 1.5rem;
        position: sticky;
        top: 0;
        z-index: 100;
        margin-bottom: 3rem;
      }
      .header-container {
        max-width: 760px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .logo-icon {
        font-size: 1.3rem;
      }
      .logo-text {
        font-weight: 800;
        font-size: 1.2rem;
        color: #18181b;
        letter-spacing: -0.03em;
      }
      .logo-highlight {
        color: #16a34a; /* Matches premium green accents */
      }

      .wrapper { max-width: 760px; margin: 0 auto; padding: 0 1.5rem; }
      
      /* Main Card Interface */
      .card { 
        background: #ffffff; 
        border-radius: 20px; 
        padding: 3rem; 
        box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.05); 
        border: 1px solid #e4e4e7;
      }

      /* Hero Image Styling */
      .hero-image {
        width: 100%;
        height: 280px;
        object-fit: cover;
        border-radius: 12px;
        margin-bottom: 2rem;
        background-color: #e4e4e7;
      }
      
      h1 { font-size: 2.2rem; color: #18181b; margin-top: 0; line-height: 1.2; font-weight: 800; letter-spacing: -0.03em; }
      
      /* Modern Segmented Toggle */
      .toggle-container { 
        display: inline-flex; 
        background: #f4f4f5; 
        padding: 6px; 
        border-radius: 14px; 
        margin: 1.5rem 0 2.5rem 0; 
      }
      .toggle-container a { 
        padding: 0.85rem 1.5rem; 
        text-decoration: none; 
        color: #71717a; 
        font-weight: 600; 
        border-radius: 10px; 
        font-size: 0.95rem; 
        transition: all 0.2s ease; 
      }
      .toggle-container a.active { 
        background: #ffffff; 
        color: #18181b; 
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03); 
      }
      .toggle-container a:hover:not(.active) { color: #18181b; }
      
      /* Clean Data Grid */
      .data-grid { display: flex; flex-direction: column; gap: 1rem; margin-top: 1.5rem; }
      .data-row { 
        display: flex; 
        justify-content: space-between; 
        padding: 1.25rem 1.5rem; 
        background: #fafafa; 
        border-radius: 12px; 
        border: 1px solid #f4f4f5; 
        align-items: center;
      }
      .data-label { color: #71717a; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
      .data-value { font-weight: 700; color: #18181b; font-size: 1.1rem; text-align: right; max-width: 60%; line-height: 1.3;}
      
      /* Context Section */
      .context-box { margin-top: 3.5rem; padding-top: 2.5rem; border-top: 1px solid #e4e4e7; }
      .context-box h2 { font-size: 1.5rem; color: #18181b; margin-bottom: 1rem; letter-spacing: -0.02em; }
      .context-box p { font-size: 1.05rem; color: #52525b; }
      
      /* Premium Portal CTA */
      .portal-card { 
        margin-top: 2.5rem; 
        background: linear-gradient(145deg, #f0fdf4 0%, #dcfce7 100%); 
        padding: 2rem; 
        border-radius: 16px; 
        border: 1px solid #bbf7d0; 
        display: flex; 
        align-items: center; 
        justify-content: space-between; 
        flex-wrap: wrap; 
        gap: 1.5rem;
      }
      .portal-text h3 { margin: 0 0 0.4rem 0; color: #166534; font-size: 1.2rem; letter-spacing: -0.01em;}
      .portal-text p { margin: 0; color: #15803d; font-size: 0.95rem; }
      .portal-btn { 
        background: #16a34a; 
        color: white; 
        padding: 0.85rem 1.75rem; 
        border-radius: 10px; 
        text-decoration: none; 
        font-weight: 600; 
        transition: all 0.2s; 
        white-space: nowrap; 
        box-shadow: 0 4px 6px -1px rgba(22, 163, 74, 0.2);
      }
      .portal-btn:hover { background: #15803d; transform: translateY(-1px); }

      @media (max-width: 600px) {
        .data-row { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
        .data-value { text-align: left; max-width: 100%; }
        .card { padding: 2rem 1.5rem; }
        .hero-image { height: 200px; }
      }
    </style>

    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8713635738444412" crossorigin="anonymous"></script>
  </head>
  <body>
    
    <header class="site-header">
      <div class="header-container">
        <span class="logo-icon">💼</span>
        <span class="logo-text">Everywhere<span class="logo-highlight">Job</span></span>
      </div>
    </header>

    <div class="wrapper">
      <div class="card">
        
        <img 
          src={`https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=800&q=80&sig=${data.countrySlug}`} 
          alt={`Beautiful view of ${data.countryName}`}
          class="hero-image"
        />

        <h1>{data.jobTitle} Salary & Visa Guide in {data.countryName}</h1>

        <nav class="toggle-container">
          <a href={`/countries/${data.countrySlug}/${data.jobSlug}/nomad`} class={type === 'nomad' ? 'active' : ''}>
            Remote Worker (Nomad)
          </a>
          <a href={`/countries/${data.countrySlug}/${data.jobSlug}/expat`} class={type === 'expat' ? 'active' : ''}>
            Local Hire (Expat)
          </a>
        </nav>

        <main>
          {type === 'nomad' ? (
            <section>
              <p style="font-size: 1.1rem; color: #52525b; margin-bottom: 2rem;">If you plan to keep your foreign salary and live in {data.countryName}, you will apply for the <strong>{data.nomadVisa}</strong>.</p>
              <div class="data-grid">
                <div class="data-row">
                  <span class="data-label">Cost of Living</span>
                  <span class="data-value">${data.costOfLiving.toLocaleString()} USD / mo</span>
                </div>
                <div class="data-row">
                  <span class="data-label">Remote Income Tax</span>
                  <span class="data-value">{data.nomadTax}</span>
                </div>
                <div class="data-row">
                  <span class="data-label">Visa Option</span>
                  <span class="data-value">{data.nomadVisa}</span>
                </div>
              </div>
            </section>
          ) : (
            <section>
              <p style="font-size: 1.1rem; color: #52525b; margin-bottom: 2rem;">To work for a local company in {data.countryName}, you will need employer sponsorship for the <strong>{data.localVisa}</strong>.</p>
              <div class="data-grid">
                <div class="data-row">
                  <span class="data-label">Cost of Living</span>
                  <span class="data-value">${data.costOfLiving.toLocaleString()} USD / mo</span>
                </div>
                <div class="data-row">
                  <span class="data-label">Average Salary</span>
                  <span class="data-value">${data.localSalary.toLocaleString()} USD / yr</span>
                </div>
                <div class="data-row">
                  <span class="data-label">Visa Option</span>
                  <span class="data-value">{data.localVisa}</span>
                </div>
              </div>
            </section>
          )}
        </main>

        <section class="portal-card">
          <div class="portal-text">
            <h3>Official Application Portal</h3>
            <p>Always use verified government resources to apply.</p>
          </div>
          <a href={data.visaLink} target="_blank" rel="noopener noreferrer" class="portal-btn">
            Visit Immigration Site →
          </a>
        </section>

        <section class="context-box">
          <h2>Living in {data.countryName}</h2>
          <p>{data.localContext}</p>
        </section>
      </div>
    </div>
  </body>
</html>