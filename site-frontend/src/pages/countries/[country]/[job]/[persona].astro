---
import data from '../../../../data.json';

export async function getStaticPaths() {
  const paths = [];
  data.forEach((row) => {
    paths.push({
      params: { country: row.countrySlug, job: row.jobSlug, persona: 'nomad' },
      props: { data: row, type: 'nomad' },
    });
    paths.push({
      params: { country: row.countrySlug, job: row.jobSlug, persona: 'expat' },
      props: { data: row, type: 'expat' },
    });
  });
  return paths;
}

const { data, type } = Astro.props;

// Smart calculations for the UI
const estRemoteSalary = data.localSalary > 4000 ? data.localSalary + 1500 : 5500 + (data.jobTitle.length * 100);
const localTaxDisplay = data.countryName === 'United Arab Emirates' ? '0% Personal Income Tax' : 'Standard progressive local tax scales';
