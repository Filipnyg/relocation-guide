---
import data from '../../data.json';

export async function getStaticPaths() {
  const uniqueCountries = [...new Set(data.map(item => item.countryName))];
  return uniqueCountries.map(name => {
    const slug = data.find(item => item.countryName === name).countrySlug;
    return {
      params: { country: slug },
      props: { countryName: name }
    };
  });
}

const { country } = Astro.params;
const { countryName } = Astro.props;

const availableJobs = data
  .filter(item => item.countrySlug === country)
  .sort((a, b) => a.jobTitle.localeCompare(b.jobTitle));
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{countryName} Relocation Guide - EverywhereJob</title>
    <style>
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background-color: #09090b; color: #e4e4e7; margin: 0; padding-bottom: 0; }
      .site-header { background: #18181b; border-bottom: 1px solid #27272a; padding: 1rem 1.5rem; margin-bottom: 3rem; position: sticky; top: 0; z-index: 100; }
      .header-container { max-width: 760px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
      .logo-link { display: flex; align-items: center; gap: 0.5rem; text-decoration: none; }
      .logo-text { font-weight: 700; font-size: 1.1rem; color: #ffffff; letter-spacing: -0.02em; text-transform: uppercase; }
      .logo-highlight { color: #10b981; }
      .nav-text-link { color: #a1a1aa; text-decoration: none; font-weight: 500; font-size: 0.9rem; }
      .nav-text-link:hover { color: #ffffff; }
      .get-started-btn { background: #10b981; color: #09090b; padding: 0.5rem 1rem; border-radius: 4px; text-decoration: none; font-weight: 600; font-size: 0.9rem; }
      
      .wrapper { max-width: 760px; margin: 0 auto; padding: 0 1.5rem 4rem 1.5rem; }
      
      .breadcrumb { font-size: 0.8rem; color: #71717a; margin-bottom: 2rem; }
      .breadcrumb a { color: #10b981; text-decoration: none; }
      .breadcrumb a:hover { text-decoration: underline; }
      .breadcrumb span { margin: 0 0.3rem; color: #3f3f46; }

      .card { background: #18181b; border-radius: 6px; padding: 2.5rem; border: 1px solid #27272a; }
      h1 { font-size: 1.75rem; margin-top: 0; color: #ffffff; font-weight: 800; letter-spacing: -0.02em; }
      .subtitle { color: #a1a1aa; font-size: 0.95rem; margin-bottom: 2.5rem; line-height: 1.5; }
      
      .link-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
      .link-list li { display: flex; justify-content: space-between; align-items: center; padding: 1rem; background: #09090b; border: 1px solid #27272a; border-radius: 4px; }
      .link-list li:hover { border-color: #10b981; }
      .job-link { font-weight: 600; text-decoration: none; color: #ffffff; font-size: 1rem; }
      .search-inline-link { font-size: 0.8rem; color: #a1a1aa; text-decoration: none; margin-top: 0.25rem; display: block; }
      .search-inline-link:hover { color: #10b981; text-decoration: underline; }
      .badge { background: #27272a; color: #e4e4e7; padding: 0.4rem 0.75rem; border-radius: 4px; font-size: 0.8rem; text-decoration: none; font-weight: 600; border: 1px solid transparent; }
      .link-list li:hover .badge { border-color: #10b981; color: #10b981; }
      
      .contact-pane { background: #18181b; color: #e4e4e7; padding: 4rem 1.5rem; text-align: center; border-top: 1px solid #27272a; }
      .contact-container { max-width: 600px; margin: 0 auto; }
      .contact-container h2 { margin-top: 0; font-size: 1.5rem; margin-bottom: 0.5rem; color: #ffffff; }
      .contact-form { display: flex; flex-direction: column; gap: 0.75rem; text-align: left; }
      .contact-form input, .contact-form textarea { width: 100%; padding: 0.85rem; border-radius: 4px; border: 1px solid #27272a; background: #09090b; color: white; font-family: inherit; font-size: 0.95rem; box-sizing: border-box; outline: none; }
      .contact-form input:focus, .contact-form textarea:focus { border-color: #10b981; }
      .contact-form button { background: #10b981; color: #09090b; border: none; padding: 0.85rem; border-radius: 4px; font-weight: 700; cursor: pointer; font-size: 0.95rem; }
      @media (max-width: 600px) { .link-list li { flex-direction: column; align-items: flex-start; gap: 1rem; } }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="header-container">
        <a href="/" class="logo-link">
          <span class="logo-text">Everywhere<span class="logo-highlight">Job</span></span>
        </a>
        <div class="nav-links" style="display: flex; gap: 1.5rem; align-items: center;">
          <a href="/compare" class="nav-text-link">Compare</a>
          <a href="/resources" class="nav-text-link">Resources</a>
          <a href="/guide" class="get-started-btn">Get Started</a>
        </div>
      </div>
    </header>
    
    <div class="wrapper">
      <div class="card">
        <nav class="breadcrumb">
          <a href="/">Home</a> <span>/</span> {countryName}
        </nav>

        <h1>{countryName}</h1>
        <p class="subtitle">Compare local salaries, living costs, and visa requirements for roles in {countryName}.</p>
        <ul class="link-list">
          {availableJobs.map(job => {
            const defaultLink = job.canWorkRemote !== false ? 'remote' : 'local';
            return (
              <li>
                <div>
                  <a href={`/countries/${country}/${job.jobSlug}/${defaultLink}`} class="job-link">{job.jobTitle}</a>
                  <a href={`https://www.linkedin.com/jobs/search/?keywords=${job.jobTitle}&location=${countryName}`} target="_blank" rel="noopener noreferrer" class="search-inline-link">Find Jobs on LinkedIn ↗</a>
                </div>
                <a href={`/countries/${country}/${job.jobSlug}/${defaultLink}`} class="badge">View Guide</a>
              </li>
            );
          })}
        </ul>
      </div>
    </div>

   <footer class="contact-pane">
      <div class="contact-container">
        <!-- Your existing contact form stays here -->
        
        <div style="display: flex; justify-content: center; gap: 1.5rem; margin-top: 3rem; margin-bottom: 1rem;">
          <a href="/about" style="color: #a1a1aa; text-decoration: none; font-size: 0.9rem; font-weight: 500;">About Us</a>
          <a href="/resources" style="color: #a1a1aa; text-decoration: none; font-size: 0.9rem; font-weight: 500;">Resources</a>
        </div>
        <p style="margin: 0; font-size: 0.75rem; color: #52525b;">EverywhereJob v2.4.0 — Compiled from official government portals and global salary reports.</p>
      </div>
    </footer>
  </body>
</html>