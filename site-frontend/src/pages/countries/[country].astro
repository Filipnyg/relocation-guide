---
import data from '../../data.json';

export async function getStaticPaths() {
  const uniqueCountries = [...new Set(data.map(item => item.countryName))];
  return uniqueCountries.map(name => {
    const slug = data.find(item => item.countryName === name).countrySlug;
    return {
      params: { country: slug },
      props: { countryName: name }
    };
  });
}

const { country } = Astro.params;
const { countryName } = Astro.props;

const availableJobs = data
  .filter(item => item.countrySlug === country)
  .sort((a, b) => a.jobTitle.localeCompare(b.jobTitle));
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{countryName} Relocation Directories - EverywhereJob</title>
    <style>
      body { font-family: 'Inter', sans-serif; background-color: #f4f4f5; color: #3f3f46; margin: 0; padding-bottom: 4rem; }
      .site-header { background: #ffffff; border-bottom: 1px solid #e4e4e7; padding: 1.25rem 1.5rem; margin-bottom: 3rem; position: sticky; top: 0; z-index: 100; }
      .header-container { max-width: 760px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
      .logo-link { display: flex; align-items: center; gap: 0.5rem; text-decoration: none; transition: opacity 0.2s; }
      .logo-link:hover { opacity: 0.8; }
      .logo-text { font-weight: 800; font-size: 1.2rem; color: #18181b; letter-spacing: -0.03em; }
      .logo-highlight { color: #16a34a; }
      .nav-text-link:hover { color: #18181b !important; }
      .get-started-btn { background: #16a34a; color: white; padding: 0.5rem 1.25rem; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.9rem; transition: background 0.2s; }
      .get-started-btn:hover { background: #15803d; }
      .wrapper { max-width: 760px; margin: 0 auto; padding: 0 1.5rem; }
      .card { background: #ffffff; border-radius: 20px; padding: 3rem; border: 1px solid #e4e4e7; }
      .hero-image { width: 100%; height: 240px; object-fit: cover; border-radius: 12px; margin-bottom: 2rem; }
      h1 { font-size: 2.2rem; margin-top: 0; color: #18181b; }
      .subtitle { color: #71717a; font-size: 1.1rem; margin-bottom: 2.5rem; margin-top: -0.5rem; }
      .link-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.75rem; }
      .link-list li { display: flex; justify-content: space-between; align-items: center; padding: 1rem; background: #fafafa; border: 1px solid #f4f4f5; border-radius: 10px; }
      .job-link { font-weight: 600; text-decoration: none; color: #27272a; font-size: 1.1rem; }
      .job-link:hover { color: #16a34a; }
      .search-inline-link { font-size: 0.85rem; color: #16a34a; text-decoration: underline; margin-top: 0.2rem; display: block; }
      .badge { background: #e4e4e7; color: #52525b; padding: 0.2rem 0.6rem; border-radius: 6px; font-size: 0.85rem; text-decoration: none; font-weight: 600; }
      .badge:hover { background: #dcfce7; color: #15803d; }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="header-container" style="justify-content: space-between; width: 100%;">
        <a href="/" class="logo-link" style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none;">
          <span class="logo-icon">💼</span>
          <span class="logo-text">Everywhere<span class="logo-highlight">Job</span></span>
        </a>
        <div style="display: flex; gap: 1.5rem; align-items: center;">
          <a href="/resources" class="nav-text-link" style="color: #71717a; text-decoration: none; font-weight: 600; font-size: 0.95rem; transition: color 0.2s;">Resources</a>
          <a href="/guide" class="get-started-btn">Get Started</a>
        </div>
      </div>
    </header>
    <div class="wrapper">
      <div class="card">
        <img src={`https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=800&q=80&sig=${country}`} alt={countryName} class="hero-image" />
        <h1>{countryName} Career Options</h1>
        <p class="subtitle">Select a profession below to see visa policies, tax details, and market salaries. Use the links to look up active vacancies.</p>
        <ul class="link-list">
          {availableJobs.map(job => (
            <li>
              <div>
                <a href={`/countries/${country}/${job.jobSlug}/remote`} class="job-link">{job.jobTitle}</a>
                <a href={`https://www.linkedin.com/jobs/search/?keywords=${job.jobTitle}&location=${countryName}`} target="_blank" rel="noopener noreferrer" class="search-inline-link">Find active openings on LinkedIn →</a>
              </div>
              <a href={`/countries/${country}/${job.jobSlug}/remote`} class="badge">View Guide →</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </body>
</html>