---
import data from '../../data.json';

export async function getStaticPaths() {
  const uniqueCountries = [...new Set(data.map(item => item.countryName))];
  return uniqueCountries.map(name => {
    const slug = data.find(item => item.countryName === name).countrySlug;
    return {
      params: { country: slug },
      props: { countryName: name }
    };
  });
}

const { country } = Astro.params;
const { countryName } = Astro.props;

const availableJobs = data
  .filter(item => item.countrySlug === country)
  .sort((a, b) => a.jobTitle.localeCompare(b.jobTitle));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{countryName} Relocation Directories - EverywhereJob</title>
    <style>
      body { font-family: 'Inter', sans-serif; background-color: #f4f4f5; color: #3f3f46; margin: 0; padding-bottom: 4rem; }
      .site-header { background: #ffffff; border-bottom: 1px solid #e4e4e7; padding: 1.25rem 1.5rem; margin-bottom: 3rem; }
      .header-container { max-width: 760px; margin: 0 auto; display: flex; text-decoration: none; color: #18181b; font-weight: 800; font-size: 1.2rem; }
      .logo-highlight { color: #16a34a; }
      .wrapper { max-width: 760px; margin: 0 auto; padding: 0 1.5rem; }
      .card { background: #ffffff; border-radius: 20px; padding: 3rem; border: 1px solid #e4e4e7; }
      .hero-image { width: 100%; height: 240px; object-fit: cover; border-radius: 12px; margin-bottom: 2rem; }
      h1 { font-size: 2.2rem; margin-top: 0; color: #18181b; }
      .link-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.75rem; }
      .link-list li a { display: flex; justify-content: space-between; padding: 1rem; background: #fafafa; border: 1px solid #f4f4f5; border-radius: 10px; text-decoration: none; color: #27272a; font-weight: 600; }
      .link-list li a:hover { background: #f0fdf4; border-color: #bbf7d0; color: #16a34a; }
    </style>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="header-container">💼 Everywhere<span class="logo-highlight">Job</span></a>
    </header>
    <div class="wrapper">
      <div class="card">
        <img src={`https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=800&q=80&sig=${country}`} alt={countryName} class="hero-image" />
        <h1>{countryName} Career Options</h1>
        <p class="subtitle">Select your profession below to see visa policies, tax details, and market salaries. Use the search links to find active vacancies.</p>
        
        <ul class="link-list">
          {availableJobs.map(job => (
            <li>
              <a href={`/countries/${country}/${job.jobSlug}/nomad`}>
                <div>
                  <span style="display:block; font-size: 1.1rem;">{job.jobTitle}</span>
                  <a href={`https://www.linkedin.com/jobs/search/?keywords=${job.jobTitle}&location=${countryName}`} target="_blank" style="font-size: 0.8rem; color: #16a34a; text-decoration: underline;">Find {job.jobTitle} jobs in {countryName} →</a>
                </div>
                <span class="badge">View Guide →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </body>
</html>