---
import data from '../data.json';

// 1. Extract completely unique countries and sort them alphabetically..
const uniqueCountries = Array.from(
  new Map(data.map(item => [item.countrySlug, item.countryName])).entries()
).map(([slug, name]) => ({ name, slug }))
.sort((a, b) => a.name.localeCompare(b.name));

// 2. Extract completely unique jobs and sort them alphabetically
const uniqueJobs = Array.from(
  new Map(data.map(item => [item.jobSlug, item.jobTitle])).entries()
).map(([slug, title]) => ({ title, slug }))
.sort((a, b) => a.title.localeCompare(b.title));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EverywhereJob - Relocation, Salary & Visa Directories</title>
    <style>
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; max-width: 1000px; margin: 0 auto; padding: 40px 20px; color: #1e293b; background: #f8fafc; }
      h1 { text-align: center; color: #0f172a; margin-bottom: 10px; font-size: 2.5rem; }
      p.subtitle { text-align: center; color: #64748b; font-size: 1.2rem; margin-bottom: 50px; }
      h2 { color: #0f172a; border-bottom: 2px solid #e2e8f0; padding-bottom: 8px; margin-top: 40px; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 15px; margin-bottom: 40px; }
      .card { background: white; padding: 15px; border-radius: 8px; box-shadow: 0 1px 3px rgb(0 0 0 / 0.1); text-decoration: none; color: #334155; font-weight: 500; transition: all 0.2s; border: 1px solid #e2e8f0; text-align: center; }
      .card:hover { border-color: #3b82f6; color: #3b82f6; transform: translateY(-2px); box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); }
    </style>
  </head>
  <body>
    <h1>EverywhereJob</h1>
    <p class="subtitle">Find your ideal global relocation paths, tax rates, and visa options for 2026.</p>

    <h2>Explore by Country</h2>
    <div class="grid">
      {uniqueCountries.map((country) => (
        /* This dynamically links to the default 'nomad' persona for the first job in our dataset for that country */
        <a href={`/countries/${country.slug}/${uniqueJobs[0].slug}/nomad`} class="card">
          {country.name}
        </a>
      ))}
    </div>

    <h2>Explore by Profession</h2>
    <div class="grid">
      {uniqueJobs.map((job) => (
        /* This dynamically links to the default 'nomad' persona for the first country in our dataset for that job */
        <a href={`/countries/${uniqueCountries[0].slug}/${job.slug}/nomad`} class="card">
          {job.title}
        </a>
      ))}
    </div>
  </body>
</html>